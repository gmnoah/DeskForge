# DeskForge reads these from the environment of the Electron main process.
# Copy the names into your shell. Do not commit real keys.
# The app does not write API keys to disk in P0.

# Fallback used when the selected preset's own variable is empty.
DESKFORGE_API_KEY=

# Optional. Overrides the preset base URL and model id at launch.
DESKFORGE_BASE_URL=
DESKFORGE_MODEL=

# Preset keys. Only the variable for the selected preset is read.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
