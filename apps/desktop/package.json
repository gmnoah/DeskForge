{
  "name": "@deskforge/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "predev": "pnpm --filter @deskforge/core build && pnpm --filter @deskforge/agent build && pnpm build",
    "dev": "electron .",
    "smoke": "pnpm predev && DESKFORGE_SMOKE=1 electron ."
  },
  "dependencies": {
    "@deskforge/agent": "workspace:*",
    "@deskforge/core": "workspace:*"
  },
  "devDependencies": {
    "electron": "35.7.5"
  }
}
